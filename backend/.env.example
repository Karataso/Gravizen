# Vitalis Backend - Variables de entorno
# Copia este archivo a .env y ajusta los valores

# App
APP_NAME=Vitalis API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
# SQLite para desarrollo (archivo local)
DATABASE_URL=sqlite:///./vitalis.db
# PostgreSQL para producción (ej. Railway, Render)
# DATABASE_URL=postgresql://user:pass@host:5432/vitalis

# CORS - Orígenes permitidos (frontend)
# En producción: solo el dominio del frontend desplegado
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Mission
DEFAULT_PROFILE=mars_transit

# Demo mode
DEMO_MODE=true
DEMO_SPEEDUP=60

# External APIs (opcional)
NASA_API_KEY=DEMO_KEY